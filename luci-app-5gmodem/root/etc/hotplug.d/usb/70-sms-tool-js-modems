#!/bin/sh
#
# luci-app-sms-tool-js: auto-configure ports for known modems by USB VID:PID.
# Fills in ONLY empty options - never overrides the user's manual choice.
#
# Compal RXM-G1 (custom firmware, reports itself as
# "Tri Cascade Inc. VOS_5G", revision contains RXMG1), VID:PID 05c6:90d6.
# The AT port (usually /dev/ttyUSB1 on the stock composition) is not
# hardcoded but probed: the DIAG port does not answer "AT", the AT port
# replies OK. The firmware supports the full SMS command set
# (+CMGF/+CMGL/+CMGS/...) and +CUSD (confirmed via an AT$QCCLAC dump),
# but the modem is managed by ModemManager over MBIM, which captures all
# messaging - so both SMS and USSD are switched to the mmcli-based path
# (sms_via_mm/ussd_via_mm). Can be disabled in the app settings.
#
# Ordering matters: the mmcli flags and the WMS route fix do NOT depend
# on the AT port, so they are applied first and unconditionally. On the
# first boot after flashing the AT probe used to fail (ModemManager holds
# the ports while probing them itself, and the first boot is slow), and
# an early exit left the flags unset.

[ "$ACTION" = "add" ] || exit 0
[ "$DEVTYPE" = "usb_device" ] || exit 0

case "$PRODUCT" in
	5c6/90d6/*) ;;
	*) exit 0 ;;
esac

# Everything below runs detached: tty ports show up after the usb_device event
(
	# The package config may not exist yet on the very first boot (the
	# uci-defaults script may run after coldplug) - create the section
	# instead of bailing out.
	if ! uci -q get sms_tool_js.@sms_tool_js[0] >/dev/null; then
		touch /etc/config/sms_tool_js
		uci -q add sms_tool_js sms_tool_js >/dev/null || exit 0
	fi

	set_if_empty() {
		[ -z "$(uci -q get "sms_tool_js.@sms_tool_js[0].$1")" ] && \
			uci set "sms_tool_js.@sms_tool_js[0].$1=$2"
	}

	# --- Stage 1: SMS and USSD via ModemManager (no port needed) ---
	if command -v mmcli >/dev/null 2>&1; then
		set_if_empty ussd_via_mm '1'
		set_if_empty sms_via_mm '1'
	fi
	uci commit sms_tool_js

	# --- Stage 2: WMS route fix (no AT port needed either) ---
	# The factory WMS routes of this firmware store incoming messages in
	# NV, where MBIM/ModemManager cannot read them - a message either
	# hangs forever in the "receiving" state with no text, or is silently
	# lost. Redirect classes 1-3 and none to the SIM (uim) - then
	# ModemManager receives messages correctly (verified on real
	# hardware). The routes survive a ModemManager restart, but we set
	# them on every device appearance in case they reset on a modem
	# power cycle. The cdc-wdm node may show up a few seconds after the
	# usb_device event.
	if command -v qmicli >/dev/null 2>&1; then
		for try in 1 2 3 4 5 6; do
			WDM=""
			for wdm in /dev/cdc-wdm*; do
				[ -c "$wdm" ] && { WDM="$wdm"; break; }
			done
			[ -n "$WDM" ] && break
			sleep 5
		done
		if [ -n "$WDM" ]; then
			for c in 1 2 3 none; do
				qmicli -p -d "$WDM" \
					--wms-set-routes="type=point,class=$c,storage=uim,receipt-action=store-and-notify" \
					>/dev/null 2>&1
			done
		fi
	fi

	# --- Stage 3: AT port probing ---
	command -v sms_tool >/dev/null || exit 0

	# vid:pid of the usb device owning a given ttyUSBx
	tty_vidpid() {
		p=$(readlink -f "/sys/class/tty/$1/device" 2>/dev/null)
		while [ -n "$p" ] && [ "$p" != "/" ]; do
			if [ -f "$p/idVendor" ] && [ -f "$p/idProduct" ]; then
				echo "$(cat "$p/idVendor"):$(cat "$p/idProduct")"
				return
			fi
			p="${p%/*}"
		done
	}

	ATPORT=""
	# Up to 8 attempts over ~40s: the ports may take a while to appear,
	# and during (the slow first) boot the AT port is briefly held by
	# ModemManager probing it.
	for try in 1 2 3 4 5 6 7 8; do
		sleep 5
		for tty in /sys/class/tty/ttyUSB*; do
			[ -e "$tty" ] || continue
			t="${tty##*/}"
			[ "$(tty_vidpid "$t")" = "05c6:90d6" ] || continue
			# the DIAG port stays silent and trips the 5s sms_tool
			# timeout, the AT port answers OK
			if sms_tool -d "/dev/$t" at "AT" >/dev/null 2>&1; then
				ATPORT="/dev/$t"
				break 2
			fi
		done
	done

	[ -n "$ATPORT" ] || exit 0

	set_if_empty readport "$ATPORT"
	set_if_empty sendport "$ATPORT"
	set_if_empty ussdport "$ATPORT"
	set_if_empty atport "$ATPORT"

	uci commit sms_tool_js
) >/dev/null 2>&1 &

exit 0
